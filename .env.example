# Copie para .env e preencha. O .env não vai para o git.

# Banco (usado pelo docker-compose)
POSTGRES_PASSWORD=troque-esta-senha

# Chave das sessões: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Primeiro administrador: criado na primeira inicialização, se o banco não tiver usuários
ADMIN_EMAIL=admin@amn.org.br
ADMIN_PASSWORD=

# Endereço pelo qual os usuários acessam o sistema (destino do retorno do login Google)
FRONTEND_URL=http://localhost:8080
PORTA=8080
# true quando o sistema estiver atrás de HTTPS
COOKIE_SECURE=false
SESSION_HOURS=10

# Login com Google (opcional). No Google Cloud Console, URI de redirecionamento autorizado:
#   <FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domínios cujas contas entram sozinhas com o papel padrão (vazio = só usuários cadastrados)
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_DEFAULT_ROLE=leitor

MAX_UPLOAD_MB=25
